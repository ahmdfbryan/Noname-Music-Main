# ====== DISCORD ======
DISCORD_TOKEN=isi_token_bot_kamu

# Voice channel tempat bot standby 24/7 (server Noname Studios Creative)
VOICE_CHANNEL_ID=1527164677941891193

# (Opsional) Channel teks untuk panel musik sticky.
# Boleh dikosongkan lalu pakai /setup-panel di Discord.
PANEL_CHANNEL_ID=

# (Opsional) Role DJ — pemegang role ini bisa kontrol musik walau tidak di voice.
# Admin (Manage Server) selalu bisa.
DJ_ROLE_ID=

# Mode channel request: ketik judul lagu langsung di channel panel -> otomatis masuk antrian.
# Kalau true, WAJIB nyalakan "Message Content Intent" di Discord Developer Portal.
REQUEST_CHANNEL_MODE=false

# ====== LAVALINK ======
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=ganti_password_lavalink_ini
LAVALINK_SECURE=false

# ====== TAMPILAN & PEMUTAR ======
DEFAULT_VOLUME=80
PANEL_COLOR=#3B82F6
# Sumber pencarian default saat ketik judul: ytmsearch (YouTube Music) / ytsearch / spsearch
DEFAULT_SEARCH=ytmsearch
MAX_QUEUE=500
